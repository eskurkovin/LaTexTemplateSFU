% Линии для титульного листа
\newsavebox{\sigcaptionbox}
\newcommand{\sig}[2][]{%
  \sbox{\sigcaptionbox}{\small #2}%
  \begin{tabular}[t]{@{}c@{}}
    \ifstrempty{#1}{\rule{\dimexpr\wd\sigcaptionbox+1.5em\relax}{0.5pt}}{#1}\\[-2pt]
    \small #2
  \end{tabular}%
}

% Эта линия без промежутка между текстом под и над ней (вплотную)
\newcommand{\sigB}[2][]{%
  \sbox{\sigcaptionbox}{\small #2}%
  \begin{tabular}[t]{@{}c@{}}
    \ifstrempty{#1}{\rule{\dimexpr\wd\sigcaptionbox+1.5em\relax}{0.5pt}}{#1}\\[-12pt]
    \small #2
  \end{tabular}%
}

% Тупо строчка с датой
\newcommand{\sigDate}{%
  «\rule[-0.3ex]{1cm}{0.5pt}»\enspace
  \rule[-0.3ex]{2.2cm}{0.5pt}\enspace
  20\rule[-0.3ex]{0.8cm}{0.5pt}\,г.%
}

% Section в центре без номера, но чтобы добавлялась в оглавление
\makeatletter
\newcommand{\centresection}{%
  \@ifstar\centresection@star\centresection@nostar}

% Обычный вариант: и заголовок, и запись в ОГЛАВЛЕНИЕ
\newcommand{\centresection@nostar}[1]{%
  \begingroup
\let\centring
\section{\begin{center}
    \textbf{#1}
\end{center}}%
\endgroup
  \addcontentsline{toc}{section}{#1}%
}

% Звёздочный вариант: только заголовок, БЕЗ оглавления
\newcommand{\centresection@star}[1]{%
  \begingroup
\let\centring
\section{\begin{center}
    \textbf{#1}
\end{center}}%
\endgroup
}

\makeatother



